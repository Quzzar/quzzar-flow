  "narrative": {
    "northStar": "Dark studio",
    "overview": "Dark studio uses a charcoal canvas, muted panels, and blue accents. The graph is the central artifact; restrained chrome and compact labels leave space for inspecting connections.\n\nManrope carries interface language, while IBM Plex Mono distinguishes contracts, paths, and illustrative payloads. Flat tonal surfaces and precise borders establish hierarchy. The inspector holds readable detail when the graph is zoomed out, especially on mobile.",
    "keyCharacteristics": [
      "Charcoal surfaces with a single blue interaction accent.",
      "Compact cards with author-supplied content and optional nested group containers.",
      "Monospaced contracts and explicit source-to-input paths.",
      "A dismissible inspector alongside or below the canvas."
    ],
    "rules": [
      {
        "name": "The Inspection Accent Rule",
        "body": "Blue identifies selection, focus, and inspectable contract structure; validation status uses its own labeled semantic colors. Authored group hues identify membership rather than interaction or validation state.",
        "section": "colors"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Express the current studio's depth with surface tones and borders; preserve the flat treatment of cards and controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use blue for selection, focus, paths, and contract types.",
      "Do keep card headers and content separate with a structural divider.",
      "Do keep group fills translucent, measure nested member content, and include bypass lanes in fit-to-view.",
