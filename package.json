{
  "name": "quzzar-system-designer",
  "version": "0.0.1",
  "private": true,
  "description": "An interactive workbench for exploring system structure and data flow.",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "bun run build:lib && bun run build:demo",
    "preview": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src examples tests scripts index.html *.json *.ts *.js *.md docs .Codex",
    "format:check": "prettier --check src examples tests scripts index.html *.json *.ts *.js *.md docs .Codex",
    "test": "bun test src/lib",
    "build:lib": "vite build --mode library && tsc -p tsconfig.build.json && bun scripts/package-assets.ts",
    "build:demo": "vite build",
    "test:e2e": "bun run build:lib && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "docs/contract-inference.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Quzzar/quzzar-system-designer.git"
  }
}
